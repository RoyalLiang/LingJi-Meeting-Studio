# Core services
NODE_ENV=development
PORT=3000
SESSION_GATEWAY_PORT=3010
TRANSCRIPT_API_PORT=3020
AI_WORKER_PORT=3030
TRANSCRIPT_API_STORAGE=memory
TRANSCRIPT_API_AUTO_MIGRATE=false

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tts
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=tts-dev
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=miniosecret

# Providers
ASR_PROVIDER=mock
ASR_FALLBACK_PROVIDER=
ASR_API_KEY=replace-me
DEEPGRAM_API_KEY=replace-me
DEEPGRAM_MODEL=nova-3
DEEPGRAM_BASE_URL=wss://api.deepgram.com/v1/listen
DOUBAO_AST_APP_ID=replace-me
DOUBAO_AST_APP_KEY=replace-me
DOUBAO_AST_ACCESS_KEY=replace-me
DOUBAO_AST_ACCESS_TOKEN=replace-me
DOUBAO_AST_SECRET=replace-me
DOUBAO_AST_RESOURCE_ID=volc.service_type.10053
DOUBAO_AST_BASE_URL=wss://openspeech.bytedance.com/api/v4/ast/v2/translate
DOUBAO_AST_ENDPOINT=v4/ast/v2/translate
DOUBAO_AST_SOURCE_LANGUAGE=zh
DOUBAO_AST_TARGET_LANGUAGE=en
DOUBAO_AST_MODE=s2t
DOUBAO_AST_CODEC_MODULE=
TRANSLATION_PROVIDER=provider_b
TRANSLATION_API_KEY=replace-me
LLM_PROVIDER=provider_c
LLM_API_KEY=replace-me

# Security
JWT_SECRET=replace-me
SHARE_LINK_SIGNING_SECRET=replace-me

# Desktop and web
APP_BASE_URL=http://localhost:3000
VIEWER_BASE_URL=http://localhost:3000/viewer
TRANSCRIPT_API_BASE_URL=http://127.0.0.1:3020
SESSION_GATEWAY_BASE_URL=http://127.0.0.1:3010
