# Copy to .env; ignored by Git. Never place provider keys in VITE_* variables.
RECORD_API_PORT=3030
WEB_PORT=3000
RECORD_DATA_DIR=.data/records
# Omit to use durable local SQLite. Postgres uses the same transactional aggregate contract.
# RECORD_DATABASE_URL=postgres://meeting:change-me@localhost:5432/meeting
# Optional S3 storage. Dedicated bucket with versioning disabled, private access only.
# RECORD_S3_BUCKET=meeting-audio
# RECORD_S3_ENDPOINT=http://localhost:9000
# RECORD_S3_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RECORD_WORKER_CONCURRENCY=3
# Independent minutes windows per job: 2 by default; use 1 for serial provider limits (maximum 4).
RECORD_MINUTES_WINDOW_CONCURRENCY=2
# Minutes synthesis input budget in UTF-8 bytes (4096-96000); leaf windows keep their own budget.
RECORD_MINUTES_SYNTHESIS_INPUT_BYTES=96000
# Shared audio volume is required when API and worker run on separate hosts.
# Production: NODE_ENV=production, HTTPS reverse proxy, secret >=32 characters and public origin required.
# RECORD_SESSION_SECRET=replace-with-a-long-random-secret
# RECORD_PUBLIC_ORIGIN=https://meet.example.com
# RECORD_INVITE_CODE=optional-registration-invite
# ASR option A: Deepgram short PCM batches (2 seconds); measured latency depends on network and provider.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# ASR option B: multipart transcription endpoint (full endpoint URL).
# ASR_API_URL=https://your-provider.example/v1/audio/transcriptions
# ASR_API_KEY=
# ASR_MODEL=whisper-1
# Full model endpoint for minutes (protocol selected below).
# LLM_API_URL=https://your-provider.example/v1/responses
# LLM_API_KEY=
# LLM_MODEL=
# 豆包专用翻译模型。未单独设置地址时复用完整 LLM_API_URL；设置不同地址时须填写专用密钥。
DOUBAO_TRANSLATION_MODEL=doubao-seed-translation-250915
# DOUBAO_TRANSLATION_API_URL=
# DOUBAO_TRANSLATION_API_KEY=
# Explicit fixture mode ONLY for development and automated tests. Never real recognition.
# RECORD_PROVIDER=fixture

# Browser workbench defaults to Doubao v3 ASR. Existing AST credentials remain supported.
ASR_PROVIDER=doubao
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_API_KEY=
DOUBAO_AST_BASE_URL=wss://openspeech.bytedance.com/api/v4/ast/v2/translate
DOUBAO_AST_RESOURCE_ID=volc.service_type.10053
DOUBAO_AST_APP_KEY=
DOUBAO_AST_ACCESS_KEY=
# In production, only these email addresses can edit provider settings.
RECORD_CONFIG_ADMIN=
# Development only. Set RECORD_DEV_ACCOUNT=off to disable seeding and the local sign-in hint.
RECORD_DEV_ACCOUNT=on
RECORD_DEV_EMAIL=dev@local.test
RECORD_DEV_PASSWORD=

# chat-completions 或 responses；LLM_API_URL 必须填写完整接口，按原值使用
LLM_PROTOCOL=responses
# auto preserves the live Kimi optimization; default leaves reasoning to the model.
LLM_REASONING_EFFORT=auto

# 豆包识别术语，用逗号分隔；总长最多 100 字，每词最多 50 字
# DOUBAO_ASR_HOTWORDS=聆记,Redis Sentinel

# Optional user-provided domain context, max 400 characters / 1600 UTF-8 bytes (engineering limits).
# Sent only on a new bigmodel_async second-pass connection; not a tokenizer guarantee or automatic history.
# DOUBAO_ASR_CONTEXT=本次讨论港口车辆调度、路径规划与设备联调。

# 纪要输入模式：默认保留 ASR＋LLM。Realtime 原音直入，ASR 并行提供引用依据。
MINUTES_MODE=asr-llm
# Opt in only after checking the configured provider supports strict JSON Schema.
# Unsupported providers fail explicitly; this does not enable silent fallback.
# LLM_STRUCTURED_OUTPUTS=true
# doubao-audio uses LLM_* (Responses) for native audio + parallel ASR evidence.
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_API_KEY=
