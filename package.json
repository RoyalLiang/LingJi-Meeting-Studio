{
  "name": "tts-platform",
  "private": true,
  "version": "0.1.32",
  "packageManager": "npm@10.8.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build:desktop:styles": "tailwindcss -i ./shell.tailwind.css -o ./shell.generated.css --cwd ./apps/desktop/src --optimize",
    "dev:desktop": "node ./apps/desktop/src/shell-server.mjs",
    "dev:desktop:mock": "node ./apps/desktop/src/mock-client.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:gateway": "node ./services/session-gateway/src/server.mjs",
    "dev:api": "node ./services/transcript-api/src/server.mjs",
    "dev:ai": "node ./services/ai-worker/src/worker.mjs",
    "db:migrate:transcript": "node ./services/transcript-api/src/migrate.mjs",
    "lint": "eslint services/records/src packages/records/src scripts tests/records*.mjs apps/web/src/production-server.mjs",
    "test": "node --test --test-concurrency=1 ./tests/memory-smoke.test.mjs ./tests/provider-and-desktop-preview.test.mjs ./tests/domain-and-components.test.mjs ./tests/records.test.mjs ./tests/records-resilience.test.mjs ./tests/records-providers.test.mjs ./tests/records-streaming.test.mjs ./tests/records-automation.test.mjs ./tests/records-speakers.test.mjs tests/records-recovery.test.mjs ./tests/records-realtime.test.mjs ./tests/records-capture.test.mjs ./tests/records-meeting-lifecycle.test.mjs ./tests/records-meeting-order.test.mjs ./tests/records-startup-performance.test.mjs ./tests/records-minutes-views.test.mjs ./tests/records-workbench-ux.test.mjs ./tests/records-lifecycle.test.mjs ./tests/records-settings-quality.test.mjs ./tests/records-asr-quality.test.mjs ./tests/records-preview-release.test.mjs ./tests/records-live-reading.test.mjs ./tests/records-workspaces.test.mjs ./tests/records-telemetry.test.mjs ./tests/records-projections.test.mjs ./tests/records-queue.test.mjs ./tests/records-minutes-pipeline.test.mjs ./tests/records-native-client.test.mjs ./tests/records-client-update.test.mjs ./tests/records-native-menu.test.mjs ./tests/records-minutes-layout.test.mjs ./tests/records-minutes-quality.test.mjs ./tests/records-auth-stability.test.mjs ./tests/records-recording-playback.test.mjs ./tests/records-exports.test.mjs tests/records-playback-transport.test.mjs ./tests/records-toast.test.mjs ./tests/records-feedback-notice.test.mjs ./tests/records-source-share.test.mjs ./tests/records-learning.test.mjs ./tests/records-learning-display.test.mjs ./tests/records-learning-integration.test.mjs ./tests/records-openai-realtime.test.mjs ./tests/records-doubao-audio.test.mjs ./tests/records-playback-waveform.test.mjs ./tests/records-funasr.test.mjs ./tests/records-local-asr.test.mjs ./tests/records-local-asr-pipeline.test.mjs ./tests/records-audio-storage-sync.test.mjs ./tests/records-release-source.test.mjs ./tests/records-desktop-entry.test.mjs ./tests/records-minutes-context.test.mjs tests/records-sensevoice-minutes-smoke.test.mjs ./tests/records-connection-status.test.mjs",
    "test:smoke": "node --test --test-concurrency=1 ./tests/memory-smoke.test.mjs ./tests/provider-and-desktop-preview.test.mjs ./tests/domain-and-components.test.mjs",
    "test:domain": "node --test ./tests/domain-and-components.test.mjs",
    "test:postgres": "node --test --test-concurrency=1 ./tests/postgres-smoke.test.mjs",
    "typecheck": "npm run typecheck -w apps/web",
    "dev:legacy-web": "node ./apps/web/src/server.mjs",
    "dev:records": "node services/records/src/server.mjs",
    "dev:record-worker": "node services/records/src/worker.mjs",
    "dev": "node scripts/dev.mjs",
    "build:web": "npm run build -w apps/web",
    "test:records": "node --test --test-concurrency=1 tests/records.test.mjs tests/records-resilience.test.mjs tests/records-providers.test.mjs",
    "start": "node scripts/dev.mjs --production",
    "test:records:postgres": "node --test tests/records-postgres.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "dev:client": "npm run build:web && npm run dev:native -w apps/desktop",
    "build:client": "npm run build:web && npm run build:native -w apps/desktop",
    "test:client": "node --test tests/records-native-client.test.mjs && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "release:client:plan": "node scripts/client-release.mjs plan",
    "release:client:build": "node scripts/client-release.mjs build",
    "evaluate:asr": "node scripts/evaluate-asr.mjs",
    "evaluate:minutes": "node scripts/evaluate-minutes.mjs",
    "benchmark:startup": "node scripts/benchmark-client-startup.mjs",
    "release:macos:preview": "TTS_RELEASE_CHANNEL=preview node scripts/release-macos-alpha.mjs",
    "test:client:updates": "node --test tests/records-client-update.test.mjs",
    "release:windows:preview": "node scripts/release-windows-preview.mjs",
    "release:linux:preview": "node scripts/release-linux-preview.mjs"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.2.2",
    "@tauri-apps/cli": "2.12.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "tailwindcss": "^4.2.2"
  }
}
