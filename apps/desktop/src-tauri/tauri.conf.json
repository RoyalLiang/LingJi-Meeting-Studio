{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聆记",
  "version": "0.3.29",
  "identifier": "com.tts.meeting",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.6",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "bundleVersion": "0.3.29"
    },
    "resources": {
      "resources/client-backend/": "client-backend/",
      "resources/runtime/": "runtime/",
      "vendor/speexdsp/COPYING": "licenses/SpeexDSP-COPYING",
      "vendor/speexdsp/SOURCE.md": "licenses/SpeexDSP-SOURCE.md",
      "vendor/speexdsp/KISS-FFT-COPYING": "licenses/KISS-FFT-COPYING",
      "vendor/CPAL-COPYING": "licenses/CPAL-COPYING",
      "vendor/speexdsp/THIRD-PARTY-NOTICES": "licenses/SpeexDSP-NOTICES"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": ""
    }
  }
}
