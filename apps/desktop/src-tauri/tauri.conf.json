{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聆记",
  "version": "0.1.0",
  "identifier": "com.tts.meeting",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.6",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": ""
    }
  }
}
