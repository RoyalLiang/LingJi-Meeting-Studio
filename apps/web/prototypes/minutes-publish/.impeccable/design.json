  "narrative": {
    "northStar": "留白有序的会议工作台",
    "overview": "以白色工作面承载会议内容，浅中性框架分隔导航，克制玉绿标记主操作、选中与键盘焦点。密度来自紧凑的控件和稳定的分隔线，阅读区保留呼吸空间。\n\n本文件描述本目录 V4 隔离原型的实际样式，属于待用户验收的视觉提案；不替代全局产品设计系统。保留现有聆记标识，使用本地系统字体，不引入展示字体、摄影或插画。",
    "keyCharacteristics": [
      "白色主体与中性导航",
      "玉绿只承担操作和状态强调",
      "单框分区，避免层层卡片",
      "桌面并列、手机单区切换"
    ],
    "rules": [
      {
        "name": "The Restrained Jade Rule",
        "body": "玉绿用于主要操作、选中与焦点；长文本和主工作面使用中性色。",
        "section": "colors"
      },
      {
        "name": "The Readable Context Rule",
        "body": "辅助信息保持次级层级，同时让当前会议名称、版本与只读范围在助手中可见。",
        "section": "typography"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "工作面依靠边框、留白和淡底色分层；阴影只服务对话框与临时反馈。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保留现有聆记标识、白色工作面和克制玉绿。",
      "Do 在窄屏用页签切换设置/预览、对话/结果；扩展中心切换列表/详情。",
      "Do 让关键控件保持可见焦点，并保留明确的模拟、只读和独立草稿说明。"
    ],
    "donts": [
      "Don't 用装饰阴影或重复嵌套卡片替代内容分区。",
      "Don't 将原型顺序导航悬浮在主要操作之上。",
      "Don't 将此原型的视觉提案或模拟状态描述为已获最终验收或生产能力。"
    ]
  }
}
