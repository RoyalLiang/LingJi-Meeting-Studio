{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@tts/shared-types/*": [
        "packages/shared-types/src/*"
      ],
      "@tts/config/*": [
        "packages/config/*"
      ]
    }
  }
}
